# Copy these values into your local environment (or a private .env loader). Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional Razorpay test keys; leave blank to keep Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional MySQL connection; requires requirements-mysql.txt.
DB_ENGINE=sqlite
MYSQL_DATABASE=foodiehub
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
